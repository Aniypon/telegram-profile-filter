{
  "work_mode": "search",
  "parse": {
    "save_dir": "./forms"
  },
  "search": {
    "forms": {
      "age": {
        "min_age": 18,
        "max_age": 21,
        "check_age_in_text": false
      },
      "about_text": {
        "minimal_text_size": 60,
        "skip_empty_texts": true
      },
      "notify": {
        "enabled": true,
        "move_on_top": false
      }
    },
    "auto_continue": {
      "enabled": true,
      "monitor_user_actions": true
    },
    "allow_save": false,
    "allow_exit": true,
    "save_media": true
  },
  "telegram": {
    "delay_between_requests": 0.1,
    "adaptive_delay": true,
    "max_delay": 1.0,
    "min_delay": 0.1,
    "cache_duration": 1.0,
    "concurrent_downloads": 2,
    "timeout_seconds": 60,
    "flood_wait_threshold": 60,
    "backoff_factor": 1.5
  },
  "performance": {
    "enable_caching": true,
    "enable_parallel_downloads": true,
    "enable_performance_monitoring": true,
    "batch_size": 5,
    "max_concurrent_operations": 3
  }
} 